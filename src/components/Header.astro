---
import HeaderLink from './HeaderLink.astro';
const base = import.meta.env.BASE_URL;
---

<header>
	<nav>
		<h2><a href={base}>THE <span class="brand">꿈자람교실</span></a></h2>
		<div class="internal-links">
			<HeaderLink href={base}>홈</HeaderLink>
			<HeaderLink href={`${base}blog/`}>블로그</HeaderLink>
			<HeaderLink href={`${base}about/`}>소개</HeaderLink>
			<HeaderLink href={`${base}ask/`}>비밀 질문</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		font-weight: 700;
		color: var(--accent);
	}
	h2 .brand {
		color: rgb(var(--gray-dark));
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
