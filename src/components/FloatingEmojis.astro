---
// 배경에 떠다니는 이모지 (헤더 아래 ~600px 영역)
// 너무 많이 두면 난잡해 보이므로 5개로 시작
---

<div class="floating-emojis" aria-hidden="true">
	<span class="emo emo-1">🌱</span>
	<span class="emo emo-2">⭐</span>
	<span class="emo emo-3">💛</span>
	<span class="emo emo-4">✨</span>
	<span class="emo emo-5">🌼</span>
</div>

<style>
	.floating-emojis {
		position: absolute;
		top: 60px;
		left: 0;
		right: 0;
		height: 540px;
		pointer-events: none;
		overflow: hidden;
		z-index: 0;
	}
	.emo {
		position: absolute;
		opacity: 0.28;
		animation: floatY 6s ease-in-out infinite;
		user-select: none;
	}
	.emo-1 {
		top: 8%;
		left: 6%;
		font-size: 1.8rem;
		animation-delay: 0s;
	}
	.emo-2 {
		top: 14%;
		right: 8%;
		font-size: 1.5rem;
		animation-delay: 1.2s;
	}
	.emo-3 {
		top: 38%;
		left: 4%;
		font-size: 1.7rem;
		animation-delay: 2.4s;
	}
	.emo-4 {
		top: 50%;
		right: 5%;
		font-size: 1.4rem;
		animation-delay: 0.6s;
	}
	.emo-5 {
		top: 70%;
		left: 9%;
		font-size: 1.6rem;
		animation-delay: 1.8s;
	}

	@keyframes floatY {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-14px);
		}
	}

	@media (max-width: 720px) {
		.emo {
			opacity: 0.22;
		}
		.emo-1,
		.emo-3,
		.emo-5 {
			font-size: 1.3rem;
		}
		.emo-2,
		.emo-4 {
			font-size: 1.15rem;
		}
	}
</style>
