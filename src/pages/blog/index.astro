---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FloatingEmojis from '../../components/FloatingEmojis.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// draft가 아닌 글만 가져오기
const allPosts = await getCollection('blog', ({ data }) => data.draft !== true);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 등장한 카테고리 자동 수집 (중복 제거, 가나다순)
const categories = Array.from(
	new Set(posts.map((p) => p.data.category).filter((c): c is string => !!c)),
).sort((a, b) => a.localeCompare(b, 'ko'));
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`블로그 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				position: relative;
				z-index: 1;
			}
			h1.page-title {
				font-size: 1.8em;
				margin-bottom: 0.3em;
			}
			.page-desc {
				color: rgb(var(--gray));
				margin-bottom: 1.5em;
			}
			.filter-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-bottom: 2em;
				padding-bottom: 1em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.filter-btn {
				background: white;
				border: 1.5px solid rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.4em 1em;
				border-radius: 50px;
				font-size: 0.9em;
				font-weight: 500;
				cursor: pointer;
				font-family: inherit;
				transition: all 0.2s ease;
			}
			.filter-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.filter-btn.active {
				background: var(--accent);
				border-color: var(--accent);
				color: white;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li.hidden {
				display: none;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.category-badge {
				display: inline-block;
				background: #fff3e0;
				color: var(--accent);
				font-size: 0.78rem;
				font-weight: 700;
				padding: 3px 10px;
				border-radius: 50px;
				border: 1.5px solid #ffab70;
				margin-bottom: 0.5em;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.3;
				font-size: 1.25em;
			}
			.date {
				margin: 0.3em 0 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.desc {
				margin: 0.5em 0 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95em;
				line-height: 1.6;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: var(--accent);
			}
			.empty-msg {
				text-align: center;
				color: rgb(var(--gray));
				padding: 3em 0;
				display: none;
			}
			.empty-msg.show {
				display: block;
			}
			@media (max-width: 720px) {
				ul {
					gap: 1.2em;
				}
				ul li {
					width: 100%;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<FloatingEmojis />
		<main>
			<h1 class="page-title">블로그</h1>
			<p class="page-desc">센터 소식과 양육에 도움이 될 만한 이야기를 담아가고 있습니다.</p>

			<div class="filter-bar">
				<button class="filter-btn active" data-cat="all">전체 ({posts.length})</button>
				{
					categories.map((cat) => {
						const count = posts.filter((p) => p.data.category === cat).length;
						return (
							<button class="filter-btn" data-cat={cat}>
								{cat} ({count})
							</button>
						);
					})
				}
			</div>

			<section>
				<ul id="post-list">
					{
						posts.map((post) => (
							<li data-cat={post.data.category || ''}>
								<a href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									{post.data.category && <span class="category-badge">{post.data.category}</span>}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									{post.data.description && <p class="desc">{post.data.description}</p>}
								</a>
							</li>
						))
					}
				</ul>
				<p class="empty-msg" id="empty-msg">이 분류의 글이 아직 없습니다.</p>
			</section>
		</main>
		<Footer />

		<script is:inline>
			const buttons = document.querySelectorAll('.filter-btn');
			const items = document.querySelectorAll('#post-list > li');
			const emptyMsg = document.getElementById('empty-msg');

			buttons.forEach((btn) => {
				btn.addEventListener('click', () => {
					const target = btn.getAttribute('data-cat');
					buttons.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');

					let visibleCount = 0;
					items.forEach((li) => {
						const cat = li.getAttribute('data-cat');
						if (target === 'all' || cat === target) {
							li.classList.remove('hidden');
							visibleCount++;
						} else {
							li.classList.add('hidden');
						}
					});
					emptyMsg.classList.toggle('show', visibleCount === 0);
				});
			});
		</script>
	</body>
</html>
