---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--primary: #ff8c42;
				--secondary: #fff3e0;
				--accent-coral: #ffab70;
				--bg-warm: #fffdf7;
				--text-dark: #4a3728;
				--muted: #a0846d;
				--white: #ffffff;
				--shadow: 0 4px 20px rgba(74, 55, 40, 0.1);
				--shadow-hover: 0 8px 30px rgba(255, 140, 66, 0.25);
				--radius: 16px;
				--transition: 0.3s ease;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				background-color: var(--bg-warm) !important;
				background-image: none !important;
				color: var(--text-dark);
				line-height: 1.6;
				letter-spacing: normal;
				word-break: keep-all;
			}

			body > main {
				width: auto;
				max-width: none;
				padding: 0;
			}

			/* ── 네비게이션 ── */
			.landing-nav {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 100;
				padding: 16px 40px;
				display: flex;
				justify-content: space-between;
				align-items: center;
				transition: background var(--transition), box-shadow var(--transition);
			}

			.landing-nav.scrolled {
				background: rgba(255, 253, 247, 0.95);
				backdrop-filter: blur(8px);
				box-shadow: 0 2px 16px rgba(74, 55, 40, 0.08);
			}

			.nav-logo {
				font-size: 1.2rem;
				font-weight: 700;
				color: var(--primary);
				letter-spacing: -0.3px;
			}

			.nav-logo span {
				color: var(--text-dark);
			}

			.nav-logo a {
				text-decoration: none;
				color: inherit;
			}

			.nav-links {
				display: flex;
				gap: 32px;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.nav-links a {
				text-decoration: none;
				color: var(--text-dark);
				font-weight: 500;
				font-size: 0.95rem;
				transition: color var(--transition);
			}

			.nav-links a:hover {
				color: var(--primary);
			}

			.nav-cta {
				background: var(--primary);
				color: var(--white) !important;
				padding: 8px 20px;
				border-radius: 50px;
				transition: background var(--transition), transform var(--transition) !important;
			}

			.nav-cta:hover {
				background: #e67a32 !important;
				color: var(--white) !important;
				transform: translateY(-1px);
			}

			/* ── Hero ── */
			#hero {
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 100px 40px 60px;
				position: relative;
				overflow: hidden;
				background: linear-gradient(160deg, #fffdf7 0%, #fff3e0 60%, #ffe4c4 100%);
			}

			.hero-bg-shapes {
				position: absolute;
				inset: 0;
				pointer-events: none;
				overflow: hidden;
			}

			.shape {
				position: absolute;
				border-radius: 50%;
				opacity: 0.15;
			}

			.shape-1 {
				width: 400px;
				height: 400px;
				background: var(--primary);
				top: -100px;
				right: -80px;
			}

			.shape-2 {
				width: 250px;
				height: 250px;
				background: var(--accent-coral);
				bottom: 40px;
				left: -60px;
			}

			.shape-3 {
				width: 180px;
				height: 180px;
				background: var(--primary);
				top: 30%;
				left: 15%;
			}

			.floating-icons {
				position: absolute;
				inset: 0;
				pointer-events: none;
			}

			.float-icon {
				position: absolute;
				font-size: 2rem;
				opacity: 0.2;
				animation: float 6s ease-in-out infinite;
			}

			.float-icon:nth-child(1) {
				top: 20%;
				left: 8%;
				animation-delay: 0s;
			}
			.float-icon:nth-child(2) {
				top: 65%;
				left: 5%;
				animation-delay: 1s;
			}
			.float-icon:nth-child(3) {
				top: 15%;
				right: 12%;
				animation-delay: 2s;
			}
			.float-icon:nth-child(4) {
				top: 70%;
				right: 8%;
				animation-delay: 0.5s;
			}
			.float-icon:nth-child(5) {
				top: 40%;
				left: 2%;
				animation-delay: 1.5s;
			}
			.float-icon:nth-child(6) {
				top: 40%;
				right: 3%;
				animation-delay: 3s;
			}

			@keyframes float {
				0%,
				100% {
					transform: translateY(0px);
				}
				50% {
					transform: translateY(-18px);
				}
			}

			.hero-content {
				text-align: center;
				max-width: 700px;
				position: relative;
				z-index: 1;
			}

			.hero-badge {
				display: inline-block;
				background: var(--white);
				color: var(--primary);
				font-size: 0.85rem;
				font-weight: 700;
				padding: 6px 18px;
				border-radius: 50px;
				border: 2px solid var(--accent-coral);
				margin-bottom: 24px;
				letter-spacing: 0.5px;
			}

			.hero-title {
				font-size: clamp(2.4rem, 6vw, 3.8rem);
				font-weight: 900;
				color: var(--text-dark);
				line-height: 1.25;
				margin-bottom: 20px;
				letter-spacing: -1px;
			}

			.hero-title em {
				font-style: normal;
				color: var(--primary);
			}

			.hero-subtitle {
				font-size: clamp(1rem, 2.5vw, 1.2rem);
				color: var(--muted);
				font-weight: 400;
				margin-bottom: 40px;
				line-height: 1.7;
			}

			.hero-buttons {
				display: flex;
				gap: 16px;
				justify-content: center;
				flex-wrap: wrap;
			}

			.btn-primary {
				background: var(--primary);
				color: var(--white);
				padding: 14px 32px;
				border: none;
				border-radius: 50px;
				font-size: 1rem;
				font-weight: 700;
				font-family: inherit;
				cursor: pointer;
				transition: background var(--transition), transform var(--transition),
					box-shadow var(--transition);
				text-decoration: none;
				display: inline-block;
				box-shadow: 0 4px 15px rgba(255, 140, 66, 0.4);
			}

			.btn-primary:hover {
				background: #e67a32;
				transform: translateY(-3px);
				box-shadow: 0 8px 25px rgba(255, 140, 66, 0.5);
			}

			.btn-outline {
				background: transparent;
				color: var(--primary);
				padding: 14px 32px;
				border: 2px solid var(--primary);
				border-radius: 50px;
				font-size: 1rem;
				font-weight: 700;
				font-family: inherit;
				cursor: pointer;
				transition: all var(--transition);
				text-decoration: none;
				display: inline-block;
			}

			.btn-outline:hover {
				background: var(--primary);
				color: var(--white);
				transform: translateY(-3px);
			}

			.hero-stats {
				display: flex;
				justify-content: center;
				gap: 48px;
				margin-top: 60px;
				flex-wrap: wrap;
			}

			.stat-item {
				text-align: center;
			}

			.stat-number {
				font-size: 2rem;
				font-weight: 900;
				color: var(--primary);
				line-height: 1;
			}

			.stat-label {
				font-size: 0.85rem;
				color: var(--muted);
				margin-top: 4px;
			}

			/* ── 공통 섹션 ── */
			section {
				padding: 90px 40px;
			}

			.section-header {
				text-align: center;
				max-width: 600px;
				margin: 0 auto 60px;
			}

			.section-tag {
				display: inline-block;
				background: var(--secondary);
				color: var(--primary);
				font-size: 0.8rem;
				font-weight: 700;
				padding: 5px 16px;
				border-radius: 50px;
				margin-bottom: 14px;
				letter-spacing: 0.5px;
			}

			.section-title {
				font-size: clamp(1.7rem, 4vw, 2.4rem);
				font-weight: 900;
				color: var(--text-dark);
				line-height: 1.3;
				margin-bottom: 16px;
				letter-spacing: -0.5px;
			}

			.section-desc {
				color: var(--muted);
				font-size: 1rem;
				line-height: 1.7;
			}

			.fade-in {
				opacity: 0;
				transform: translateY(30px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}

			.fade-in.visible {
				opacity: 1;
				transform: translateY(0);
			}

			.fade-in-delay-1 {
				transition-delay: 0.1s;
			}
			.fade-in-delay-2 {
				transition-delay: 0.2s;
			}
			.fade-in-delay-3 {
				transition-delay: 0.3s;
			}
			.fade-in-delay-4 {
				transition-delay: 0.4s;
			}

			/* ── About ── */
			#about {
				background: var(--white);
			}

			.about-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 60px;
				align-items: center;
				max-width: 1100px;
				margin: 0 auto;
			}

			.about-text h2 {
				font-size: clamp(1.6rem, 3.5vw, 2.2rem);
				font-weight: 900;
				color: var(--text-dark);
				line-height: 1.35;
				margin-bottom: 20px;
				letter-spacing: -0.5px;
			}

			.about-text p {
				color: var(--muted);
				line-height: 1.8;
				margin-bottom: 16px;
				font-size: 0.97rem;
			}

			.about-values {
				display: flex;
				flex-direction: column;
				gap: 20px;
			}

			.value-card {
				display: flex;
				align-items: flex-start;
				gap: 18px;
				background: var(--bg-warm);
				padding: 22px 24px;
				border-radius: var(--radius);
				border-left: 4px solid var(--primary);
				transition: box-shadow var(--transition), transform var(--transition);
			}

			.value-card:hover {
				box-shadow: var(--shadow);
				transform: translateX(4px);
			}

			.value-icon {
				font-size: 1.8rem;
				flex-shrink: 0;
				line-height: 1;
			}

			.value-info h4 {
				font-size: 1rem;
				font-weight: 700;
				color: var(--text-dark);
				margin-bottom: 4px;
			}

			.value-info p {
				font-size: 0.88rem;
				color: var(--muted);
				margin: 0;
			}

			/* ── 프로그램 ── */
			#programs {
				background: var(--bg-warm);
			}

			.programs-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 24px;
				max-width: 1100px;
				margin: 0 auto;
			}

			.program-card {
				background: var(--white);
				border-radius: var(--radius);
				padding: 36px 28px;
				box-shadow: var(--shadow);
				transition: transform var(--transition), box-shadow var(--transition);
				position: relative;
				overflow: hidden;
			}

			.program-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 4px;
				background: linear-gradient(90deg, var(--primary), var(--accent-coral));
			}

			.program-card:hover {
				transform: translateY(-8px);
				box-shadow: var(--shadow-hover);
			}

			.program-icon {
				font-size: 2.5rem;
				margin-bottom: 16px;
				display: block;
			}

			.program-card h3 {
				font-size: 1.2rem;
				font-weight: 700;
				color: var(--text-dark);
				margin-bottom: 10px;
			}

			.program-card p {
				font-size: 0.9rem;
				color: var(--muted);
				line-height: 1.7;
				margin-bottom: 20px;
			}

			.badges {
				display: flex;
				gap: 8px;
				flex-wrap: wrap;
			}

			.badge {
				font-size: 0.78rem;
				font-weight: 700;
				padding: 4px 12px;
				border-radius: 50px;
			}

			.badge-one {
				background: #fff3e0;
				color: var(--primary);
				border: 1.5px solid var(--accent-coral);
			}

			.badge-group {
				background: #e8f5e9;
				color: #388e3c;
				border: 1.5px solid #a5d6a7;
			}

			/* ── CTA ── */
			#contact {
				background: linear-gradient(135deg, var(--primary) 0%, #e67a32 100%);
				color: var(--white);
				text-align: center;
				padding: 90px 40px;
				position: relative;
				overflow: hidden;
			}

			#contact::before {
				content: '';
				position: absolute;
				top: -60px;
				right: -60px;
				width: 300px;
				height: 300px;
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.08);
			}

			#contact::after {
				content: '';
				position: absolute;
				bottom: -80px;
				left: -40px;
				width: 250px;
				height: 250px;
				border-radius: 50%;
				background: rgba(255, 255, 255, 0.06);
			}

			#contact .section-tag {
				background: rgba(255, 255, 255, 0.2);
				color: var(--white);
			}

			#contact .section-title {
				color: var(--white);
			}

			#contact .section-desc {
				color: rgba(255, 255, 255, 0.85);
			}

			.contact-buttons {
				display: flex;
				justify-content: center;
				gap: 16px;
				margin-top: 36px;
				flex-wrap: wrap;
				position: relative;
				z-index: 1;
			}

			.btn-white {
				background: var(--white);
				color: var(--primary);
				padding: 14px 32px;
				border: none;
				border-radius: 50px;
				font-size: 1rem;
				font-weight: 700;
				font-family: inherit;
				cursor: pointer;
				transition: all var(--transition);
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 8px;
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
			}

			.btn-white:hover {
				background: #fff3e0;
				transform: translateY(-3px);
				box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
			}

			.btn-white-outline {
				background: transparent;
				color: var(--white);
				padding: 14px 32px;
				border: 2px solid rgba(255, 255, 255, 0.6);
				border-radius: 50px;
				font-size: 1rem;
				font-weight: 700;
				font-family: inherit;
				cursor: pointer;
				transition: all var(--transition);
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 8px;
			}

			.btn-white-outline:hover {
				background: rgba(255, 255, 255, 0.15);
				border-color: var(--white);
				transform: translateY(-3px);
			}

			.contact-info {
				display: flex;
				justify-content: center;
				gap: 48px;
				margin-top: 52px;
				flex-wrap: wrap;
				position: relative;
				z-index: 1;
			}

			.contact-info-item {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 6px;
			}

			.contact-info-icon {
				font-size: 1.6rem;
				opacity: 0.9;
			}

			.contact-info-label {
				font-size: 0.8rem;
				opacity: 0.75;
				font-weight: 500;
			}

			.contact-info-value {
				font-size: 0.95rem;
				font-weight: 700;
				opacity: 0.95;
			}

			/* ── 푸터 ── */
			.landing-footer {
				background: var(--text-dark);
				color: rgba(255, 255, 255, 0.6);
				text-align: center;
				padding: 28px 40px;
				font-size: 0.85rem;
			}

			.landing-footer strong {
				color: rgba(255, 255, 255, 0.9);
			}

			/* ── 반응형 ── */
			@media (max-width: 768px) {
				.landing-nav {
					padding: 14px 20px;
				}
				.nav-links {
					display: none;
				}
				section {
					padding: 70px 20px;
				}
				#hero {
					padding: 90px 20px 50px;
				}
				.hero-stats {
					gap: 30px;
				}
				.about-grid {
					grid-template-columns: 1fr;
					gap: 40px;
				}
				.programs-grid {
					grid-template-columns: 1fr;
				}
				.contact-info {
					gap: 28px;
				}
			}

			@media (max-width: 480px) {
				.hero-buttons {
					flex-direction: column;
					align-items: center;
				}
				.btn-primary,
				.btn-outline {
					width: 100%;
					text-align: center;
					max-width: 300px;
				}
				.contact-buttons {
					flex-direction: column;
					align-items: center;
				}
				.btn-white,
				.btn-white-outline {
					width: 100%;
					max-width: 280px;
					justify-content: center;
				}
			}
		</style>
	</head>
	<body>
		<nav class="landing-nav" id="navbar">
			<div class="nav-logo"><a href={base}>THE <span>꿈자람교실</span></a></div>
			<ul class="nav-links">
				<li><a href="#about">소개</a></li>
				<li><a href="#programs">프로그램</a></li>
				<li><a href={`${base}blog/`}>블로그</a></li>
				<li><a href="#contact" class="nav-cta">상담 문의</a></li>
			</ul>
		</nav>

		<section id="hero">
			<div class="hero-bg-shapes">
				<div class="shape shape-1"></div>
				<div class="shape shape-2"></div>
				<div class="shape shape-3"></div>
			</div>
			<div class="floating-icons">
				<span class="float-icon">🌱</span>
				<span class="float-icon">⭐</span>
				<span class="float-icon">🎨</span>
				<span class="float-icon">💛</span>
				<span class="float-icon">🌟</span>
				<span class="float-icon">🎈</span>
			</div>
			<div class="hero-content">
				<div class="hero-badge">✨ THE 꿈자람교실</div>
				<h1 class="hero-title">
					아이의 <em>꿈</em>이<br />자라는 곳
				</h1>
				<p class="hero-subtitle">
					인지·언어·놀이·감각통합 치료로<br />
					아이의 가능성을 함께 열어드립니다
				</p>
				<div class="hero-buttons">
					<a href="#programs" class="btn-primary">프로그램 알아보기</a>
					<a href="#contact" class="btn-outline">상담 문의하기</a>
				</div>
				<div class="hero-stats">
					<div class="stat-item">
						<div class="stat-number">1:1</div>
						<div class="stat-label">개인 맞춤 수업</div>
					</div>
					<div class="stat-item">
						<div class="stat-number">4가지</div>
						<div class="stat-label">전문 치료 프로그램</div>
					</div>
					<div class="stat-item">
						<div class="stat-number">소그룹</div>
						<div class="stat-label">그룹 수업 운영</div>
					</div>
				</div>
			</div>
		</section>

		<section id="about">
			<div class="about-grid">
				<div class="about-text fade-in">
					<div class="section-tag">우리를 소개해요</div>
					<h2>모든 아이는<br />특별한 가능성을<br />가지고 있습니다</h2>
					<p>
						THE 꿈자람교실은 각 아이의 발달 특성과 필요에 맞는 맞춤형 치료 교육을 제공합니다. 전문
						치료사들과 함께 아이의 성장을 단계별로 지원합니다.
					</p>
					<p>1:1 개인 치료부터 또래 친구들과 함께하는 그룹 수업까지, 아이에게 가장 적합한 방법으로 접근합니다.</p>
				</div>
				<div class="about-values">
					<div class="value-card fade-in fade-in-delay-1">
						<div class="value-icon">🎯</div>
						<div class="value-info">
							<h4>전문성</h4>
